# or must never end up in it.

.git
.gitignore
.superpowers
docs

node_modules
**/node_modules
dist
**/dist

# Runtime data — the container creates its own on the volumes
storage
.env

# Tests are not part of the runtime image
tests
**/tests

.venv
venv
__pycache__

*.log
*.db
*.db-shm
*.db-wal

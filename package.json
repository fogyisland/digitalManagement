{
  "name": "digital-management",
  "version": "1.0.0",
  "description": "Digital Asset Management - 单端口 Node.js 应用：API + 前端 + 静态资源",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node src/server/server.js",
    "dev:server": "node --watch src/server/server.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "seed": "node src/server/scripts/seed.js",
    "seed:force": "node src/server/scripts/seed.js --force",
    "superadmin": "node src/server/scripts/superadmin.js",
    "tenant:create": "node src/server/scripts/tenant.js",
    "test": "npm run test:contract && npm run test:backend",
    "test:contract": "node tests/contract.test.js",
    "test:backend": "node tests/backend/run.js"
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.4",
    "@ant-design/icons": "^5.5.2",
    "@ant-design/pro-components": "^2.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "antd": "^5.22.5",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "nanoid": "^3.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "redoc": "^2.5.4",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}

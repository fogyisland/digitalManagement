# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local
backend/venv/
backend/__pycache__/

# Node
node_modules/
dist/
*.local

# Storage (mounted via volumes in docker)
storage/originals/*
storage/thumbnails/*
storage/previews/*
storage/temp/*
storage/manifests/*
!storage/originals/.gitkeep
!storage/thumbnails/.gitkeep
!storage/previews/.gitkeep
!storage/temp/.gitkeep
!storage/manifests/.gitkeep

# SQLite live database (user-owned, never commit)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# Backend test artifacts (transient test DBs / temp storage)
backend/tests/test-*.db
backend/tests/test-*.db-shm
backend/tests/test-*.db-wal
backend/tests/test-*/
backend/tests/tmp.db
backend/tests/tmp.db-shm
backend/tests/tmp.db-wal

# Frontend TypeScript / Vite transient build outputs
frontend/tsc-output.txt
frontend/tsconfig*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Node
node_modules/
dist/
*.local

# Secrets
.env
.env.local

# Storage (uploaded files — the skeleton is tracked, the content is not)
storage/originals/*
storage/thumbnails/*
storage/previews/*
storage/temp/*
storage/manifests/*
storage/placeholders/*
!storage/originals/.gitkeep
!storage/thumbnails/.gitkeep
!storage/previews/.gitkeep
!storage/temp/.gitkeep
!storage/manifests/.gitkeep
!storage/placeholders/.gitkeep

# The old SQLite database file (the application now uses MySQL). It stays
# ignored until it is moved or removed on purpose.
# The `**/` prefix matters: a pattern with a slash is anchored to the
# directory holding this file, so `data/*.db` alone would NOT cover
# `backend/data/`.
data/*.db
data/*.db-shm
data/*.db-wal
**/data/*.db
**/data/*.db-shm
**/data/*.db-wal

# Local throw-away MySQL instance (datadir, logs, pid, init scripts).
# It exists only to run the test suites and must never be committed.
.mysql-dev/

# Test artifacts (transient test DBs / temp storage)
tests/backend/test-*.db
tests/backend/test-*.db-shm
tests/backend/test-*.db-wal
tests/backend/test-*/
tests/backend/tmp.db
tests/backend/tmp.db-shm
tests/backend/tmp.db-wal

# TypeScript / Vite transient build outputs
tsc-output.txt
tsconfig*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Virtual environments (not used by this project, kept out of the repo)
venv/
.venv/
.venv-test/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Runtime configuration.
#
# Copy to `.env` and adjust. Every value is optional — `src/server/config.js`
# holds the defaults, and the server starts fine without this file at all.
#
# Relative paths are resolved against the repository root, not the working
# directory, so the same file works no matter where the server is started.

# --- HTTP -------------------------------------------------------------------
# The single port the server listens on. It serves the API and the built
# frontend, so this is the only port the application needs.
PORT=8000
HOST=0.0.0.0

# NOTE: the cross-origin allow list is *not* an environment variable. It lives
# in the database and is edited in the platform console under "Settings",
# together with the address this instance answers at. Changing it there takes
# effect on the next request — no restart, no redeploy.

# --- Database ---------------------------------------------------------------
# MySQL 5.7+ (or MariaDB 10.4+). The server creates the schema on boot if
# the account is allowed to, and creates any missing table and column.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_management

# How many connections the pool keeps open.
DB_POOL_SIZE=10

# --- Storage ----------------------------------------------------------------
# The directory that holds uploaded originals, thumbnails and previews.
# Relative to the repository root.
STORAGE_DIR=./storage

# --- Security ---------------------------------------------------------------
# Signing key for the access and refresh tokens. CHANGE THIS before any
# deployment that is reachable from outside the machine — changing it later
# invalidates every issued token.
#
# Leave it empty when you deploy through the init wizard (/init): the
# wizard's third page generates a random secret and writes it here. For a
# hand-rolled deployment, fill in a random string of at least 32 characters.
JWT_SECRET=

# Token lifetimes. Accepts "30d", "1h", "15m", "45s".
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=30d

# May a webhook be delivered to a private address (10.x, 172.16-31.x,
# 192.168.x, 127.0.0.1, 169.254.x, ::1)?
#
# The endpoint URL is the server's *own* outbound request, so by default it
# may not point at an address only this server can reach — the cloud
# metadata service, a database, a host on the local network. The check
# happens on every delivery, not only when the webhook is registered, and
# the connection is pinned to the address that was checked.
#
# Set this to 1 only if the webhook receiver really is inside your network
# (a service on 192.168.x.x, for example). Off by default.
WEBHOOK_ALLOW_PRIVATE_TARGETS=0

# --- Uploads ----------------------------------------------------------------
# Largest accepted upload, in megabytes.
UPLOAD_MAX_FILE_SIZE_MB=2048

# Largest total a single upload request may carry, in megabytes.
#
# The files are buffered in memory while they are read, so it is the *total*
# that has to be bounded: one request can carry twenty files, and the
# per-file limit alone would let a single call pull twenty times that into
# the process. It defaults to the per-file limit — one file's worth per
# request. Raise it if the machine has the memory for it.
UPLOAD_MAX_REQUEST_SIZE_MB=2048

# --- First boot -------------------------------------------------------------
# Set to 1 to generate the twelve sample images on a fresh installation.
# Left unset or 0, a new installation starts with an empty library.
SEED_SAMPLE_ASSETS=0

# --- Integration ------------------------------------------------------------
# How long a signed file URL stays valid, in seconds. The URL is what the
# browser puts into an `<img src>`, because an image request cannot carry an
# Authorization header.
STORAGE_URL_TTL_SECONDS=3600

# The token that guards the setup wizard (/init). It comes from the
# environment; without one, the server generates a token per boot and prints
# it to the console.
INIT_TOKEN=

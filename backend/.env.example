# ============================================
# Application
# ============================================
APP_NAME=DigitalAssetManagement
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# ============================================
# Frontend (统一端口托管)
# ============================================
FRONTEND_DIST=../frontend/dist
SERVE_FRONTEND=true

# ============================================
# Security
# ============================================
SECRET_KEY=please-change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Database (MySQL or SQLite)
# Set DB_BACKEND=sqlite for zero-config local dev (file at storage/dam.sqlite3)
# ============================================
DB_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dam
DB_PASSWORD=dam_pass
DB_NAME=digital_management

# ============================================
# Storage
# ============================================
STORAGE_ROOT=./storage
STORAGE_ORIGINALS_SUBDIR=originals
STORAGE_THUMBNAILS_SUBDIR=thumbnails
STORAGE_PREVIEWS_SUBDIR=previews
STORAGE_TEMP_SUBDIR=temp

# ============================================
# Upload limits
# ============================================
UPLOAD_MAX_FILE_SIZE_MB=2048
UPLOAD_CHUNK_SIZE_MB=8
UPLOAD_ALLOWED_IMAGE_EXT=jpg,jpeg,png,webp,gif,bmp,svg,tiff
UPLOAD_ALLOWED_VIDEO_EXT=mp4,mov,webm,mkv,avi,m4v

# ============================================
# Media processing
# ============================================
THUMBNAIL_SIZE=320
PREVIEW_MAX_WIDTH=1920
PREVIEW_QUALITY=85
VIDEO_FRAME_AT_SECOND=1.0

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================
# Default admin
# ============================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_EMAIL=admin@example.com
